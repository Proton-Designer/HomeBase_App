# HomeBase mobile (Expo) — environment variables.
# Copy this file to `.env` in the same directory, then fill in each value.
# Only EXPO_PUBLIC_* vars are exposed to the JS bundle; everything else is ignored by Expo.
#
# Source of truth for which vars the app reads:
#   grep -rn "process.env.EXPO_PUBLIC_" apps/mobile/ --include='*.ts' --include='*.tsx'
#
# After editing, fully restart Metro (`npx expo start --clear`) — env vars are
# inlined at bundle time, not hot-reloaded.

# ─── Supabase (HomeBase_MVP project: rukpypuzfqrswiybvbkg) ──────────────────
# Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://rukpypuzfqrswiybvbkg.supabase.co
# Use the new publishable key (sb_publishable_…) — Dashboard → Settings → API → "Publishable key".
# The legacy `anon` JWT (eyJ…) still works as a fallback if you have it.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Stripe (client-side only — publishable key, NOT secret key) ────────────
# Dashboard → Developers → API keys → "Publishable key"
#   • Test mode: pk_test_…
#   • Live mode: pk_live_…
# The secret key (sk_*) is set on Supabase Edge Functions, never here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Google Maps (address autocomplete + map tiles) ─────────────────────────
# Google Cloud Console → APIs & Services → Credentials → "Create credentials" → API key.
# Restrict the key to:
#   • iOS: bundle id  co.homebase.app
#   • Android: package co.homebase.app + SHA-1 fingerprint
#   • Web: HTTP referrers for your domain(s)
# Enable these APIs on the project: Maps SDK for iOS, Maps SDK for Android,
# Maps JavaScript API, Places API, Geocoding API.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
