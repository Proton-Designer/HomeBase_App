# HomeBase admin (Next.js) — environment variables.
# Copy this file to `.env.local` in the same directory, then fill in each value.
# Vars prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Everything else is server-side only — NEVER add NEXT_PUBLIC_ to a secret.
#
# Source of truth for which vars the app reads:
#   grep -rn "process.env\." apps/admin/ --include='*.ts' --include='*.tsx'

# ─── Supabase (HomeBase_MVP project: rukpypuzfqrswiybvbkg) ──────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://rukpypuzfqrswiybvbkg.supabase.co

# Publishable / anon key. Safe to expose to the browser. Same value as mobile.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-ONLY. Bypasses RLS — never expose to the client.
# Dashboard → Settings → API → "service_role" key (click "Reveal").
# Set this in Vercel (Production env) and locally; the app refuses to query
# without it (see lib/supabase-server.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin provisioning note ────────────────────────────────────────────────
# An admin user must exist in Supabase Auth AND have role='admin' in the
# `profiles` table before sign-in succeeds. There is no admin signup UI — run:
#   update profiles set role='admin'::user_role where email='ops@homebase.app';
