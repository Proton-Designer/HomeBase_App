{
  "name": "homebase",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "babel-plugin-transform-import-meta": "^2.3.3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "tailwindcss": "^3.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "packageManager": "npm@10.0.0"
}
